{
    "schema_version": 1,
    "exercises": [
        {
            "id": "sheet-month-comparison-01",
            "type": "result_based",
            "prompt": "Filter transaksi September dan urutkan berdasarkan tanggal untuk memeriksa subset periode tersebut.",
            "incorrect_feedback": "Pilih bulan 2025-09 dan urutan tanggal ascending.",
            "success_feedback": "Tepat. Kamu membuat subset periode yang dapat dibandingkan.",
            "validator": {
                "type": "table",
                "expected_columns": ["order_id", "order_date", "region", "revenue"],
                "expected_rows": [
                    ["O-1004", "2025-09-02", "West", 80],
                    ["O-1005", "2025-09-06", "East", 120],
                    ["O-1006", "2025-09-11", "West", 180],
                    ["O-1007", "2025-09-15", "South", 100],
                    ["O-1008", "2025-09-21", "West", 120]
                ],
                "row_order": "ordered",
                "required_columns": ["order_id", "order_date", "revenue"]
            },
            "interactive": {
                "type": "spreadsheet_playground",
                "dataset_key": "nusamart",
                "dataset_version": "v1",
                "mode": "table",
                "starter_filter": "all",
                "starter_sort": "order_date_asc",
                "view_columns": ["order_id", "order_date", "region", "revenue"]
            }
        },
        {
            "id": "sheet-comparison-02",
            "type": "multiple_choice",
            "prompt": "Jika revenue current 600 dan baseline 500, percentage change yang tepat?",
            "options": [
                "10%, karena difference 100 dibagi current.",
                "20%, karena difference 100 dibagi baseline 500.",
                "100%, karena difference adalah 100.",
                "500%, karena baseline menjadi denominator terbalik."
            ],
            "correct_option": 1,
            "incorrect_feedback": "Percentage change umumnya memakai baseline sebagai denominator.",
            "success_feedback": "Benar. (600 - 500) / 500 = 20%."
        }
    ]
}
